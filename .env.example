# Environment configuration example
# Copy this file to .env.local and fill in your values

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Image Service (Cloudinary is optional — Keyra supports pluggable storage)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Feature Flags
NEXT_PUBLIC_ENABLE_SEARCH=true
NEXT_PUBLIC_ENABLE_FILTERS=true
NEXT_PUBLIC_ENABLE_CONTACT_CENTRE_SIM=true

# Database (for future backend services)
DATABASE_URL=postgresql://user:password@localhost:5432/keyra_db

# Authentication / Sessions
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_secure_random_value
JWT_SECRET=replace_with_secure_random_value

# AI / LLM provider (abstraction — do NOT commit real keys)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
AI_ENDPOINT=

# Maps / Geocoding
NEXT_PUBLIC_MAPS_PROVIDER=mapbox
NEXT_PUBLIC_MAPS_API_KEY=your_mapbox_key

# Cloud Storage / Object store
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Telephony / SMS / WhatsApp providers (provider abstraction layer)
TELEPHONY_PROVIDER=simulator    # simulator | twilio | africastalking | telnyx
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
TELNYX_API_KEY=

# SIP / WebRTC
SIP_DOMAIN=
SIP_USERNAME=
SIP_PASSWORD=
WEBRTC_STUN_URI=stun:stun.l.google.com:19302
WEBRTC_TURN_URI=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_PASSWORD=

# Payments
PAYMENTS_PROVIDER=mpesa   # mpesa | stripe | dummy
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
STRIPE_API_KEY=

# Email & Notifications
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_QUEUE_URL=

# Monitoring / Observability
SENTRY_DSN=
DATADOG_API_KEY=
PROMETHEUS_PUSH_GATEWAY=

# Misc
NODE_ENV=development
PORT=3000

# Development simulator flags
SIMULATOR_ENABLE_CONTACT_CENTRE=true
SIMULATOR_CALL_RATE=0.1   # fraction of simulated incoming calls per minute

# IMPORTANT: never commit real secrets to the repository. Use your platform's secret storage for CI/CD and production.
